# Backend Environment Variables

# App
APP_NAME="Trip Tailor API"
ENVIRONMENT="development"

# APIs
GEMINI_API_KEY="your-gemini-api-key-here"

# CORS
CORS_ORIGINS="http://localhost:5173"

# Database
# Replace user, password, host, port, and dbname with your local PostgreSQL details
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/trip_tailor"

# JWT
SECRET_KEY="generate-a-long-random-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
